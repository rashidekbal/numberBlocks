<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="@dimen/dp_24">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_3"
        app:strokeColor="#D9D7CE"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/dp_24">

            <TextView
                android:id="@+id/tv_resume_mode_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resume 4×4?"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_resume_mode_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="Score: 4,820"
                android:textColor="#737680"
                android:textSize="@dimen/sp_14" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_dialog_resume_confirm"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:backgroundTint="#1E2024"
                    android:text="Resume"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_10" />

                <Button
                    android:id="@+id/btn_dialog_new_game"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_44"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="New Game"
                    android:textColor="#A63A2F"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_10"
                    app:strokeColor="#D9D7CE" />

                <Button
                    android:id="@+id/btn_dialog_cancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginTop="@dimen/dp_4"
                    android:text="Cancel"
                    android:textColor="#737680"
                    android:textSize="@dimen/sp_13" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
