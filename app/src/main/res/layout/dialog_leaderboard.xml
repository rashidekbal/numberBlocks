<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_leaderboard_dialog_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_3"
        app:cardUseCompatPadding="true"
        app:strokeColor="#D9D7CE"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_20">

            <!-- Dialog Top Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_14">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_leaderboard_trophy"
                        android:layout_width="@dimen/dp_26"
                        android:layout_height="@dimen/dp_26"
                        android:src="@drawable/ic_trophy"
                        app:tint="#F59E0B" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_10"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_lb_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LEADERBOARDS"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lb_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Global High Scores"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_11" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_close_lb_icon"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/btn_circle_surface"
                    android:contentDescription="@string/close"
                    android:padding="@dimen/dp_8"
                    android:src="@drawable/ic_close"
                    app:tint="#737680" />
            </RelativeLayout>

            <!-- Segmented Mode Tabs (4x4, 5x5, 6x6) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/container_lb_tabs"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:layout_marginBottom="@dimen/dp_14"
                app:cardBackgroundColor="#EDE0C8"
                app:cardCornerRadius="@dimen/dp_14"
                app:cardElevation="0dp"
                app:strokeColor="#D8CCA8"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_3">

                    <!-- Tab 4x4 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tab_lb_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="@dimen/dp_11"
                        app:cardElevation="@dimen/dp_2"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tv_tab_lb_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="4×4"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tab 5x5 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tab_lb_5"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="@dimen/dp_11"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tv_tab_lb_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="5×5"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tab 6x6 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tab_lb_6"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="@dimen/dp_11"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tv_tab_lb_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="6×6"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_13"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Current Player Standing Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_player_standing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                app:cardBackgroundColor="#FAF9F6"
                app:cardCornerRadius="@dimen/dp_14"
                app:cardElevation="0dp"
                app:strokeColor="#E3E1D8"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_12"
                    android:paddingEnd="@dimen/dp_14"
                    android:paddingTop="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_8">

                    <!-- Avatar Circle in Standing Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_38"
                        android:layout_height="@dimen/dp_38"
                        android:layout_marginEnd="@dimen/dp_10"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="@dimen/dp_19"
                        app:cardElevation="0dp"
                        app:strokeColor="#F59E0B"
                        app:strokeWidth="@dimen/dp_1">

                        <ImageView
                            android:id="@+id/iv_standing_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_avatar_hero" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_standing_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Player"
                                android:textColor="#1E2024"
                                android:textSize="@dimen/sp_13"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_edit_profile_hint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_4"
                                android:text="✏️"
                                android:textSize="@dimen/sp_11" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_standing_rank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rank: —"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_11" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_standing_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#1E2024"
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scores List Area -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_200">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_lb_scores"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:scrollbars="vertical" />

                <!-- Loading State -->
                <ProgressBar
                    android:id="@+id/pb_lb_loading"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:layout_gravity="center"
                    android:indeterminateTint="#F59E0B"
                    android:visibility="gone" />

                <!-- Empty State -->
                <TextView
                    android:id="@+id/tv_lb_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/dp_16"
                    android:text="No scores loaded yet.\nPlay a match to post your record!"
                    android:textColor="#737680"
                    android:textSize="@dimen/sp_13"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Bottom Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_full_lb"
                style="@style/GameButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:layout_marginTop="@dimen/dp_12"
                android:text="Open in Google Play Games"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_lb"
                style="@style/GameButton.Text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/close"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
