<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_22"
    android:paddingTop="@dimen/dp_24"
    android:paddingBottom="@dimen/dp_12">

    <!-- Top Bar: Navigation, Title & Settings -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16">

        <ImageButton
            android:id="@+id/btn_dashboard_back"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_circle_surface"
            android:contentDescription="@string/cd_back"
            android:padding="@dimen/dp_11"
            android:src="@drawable/ic_arrow_back"
            app:tint="#1E2024" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dashboard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_grid_size"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="@string/select_board_dimension"
                android:textColor="#737680"
                android:textSize="@dimen/sp_11" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_dashboard_settings"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_circle_surface"
            android:contentDescription="@string/cd_settings"
            android:padding="@dimen/dp_11"
            android:src="@drawable/ic_settings"
            app:tint="#1E2024" />
    </RelativeLayout>

    <!-- Scrollable Grid Selection Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Resume Active Game Hero Card (Conditional) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_dashboard_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/dp_18"
                app:cardElevation="@dimen/dp_2"
                app:strokeColor="#D9D7CE"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_dashboard_resume_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#ECEBE5"
                            android:paddingStart="@dimen/dp_8"
                            android:paddingEnd="@dimen/dp_8"
                            android:paddingTop="@dimen/dp_3"
                            android:paddingBottom="@dimen/dp_3"
                            android:text="ACTIVE RUN • 4×4"
                            android:textColor="#40434A"
                            android:textSize="@dimen/sp_10"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_dashboard_resume_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/score"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_18"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_dashboard_resume_run"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_40"
                        android:backgroundTint="#1E2024"
                        android:text="@string/resume"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/dp_10" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 1: 4x4 Standard -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mode_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_14"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/dp_18"
                app:cardElevation="@dimen/dp_2"
                app:strokeColor="#D9D7CE"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_52"
                        android:layout_height="@dimen/dp_52"
                        app:cardBackgroundColor="#ECEBE5"
                        app:cardCornerRadius="@dimen/dp_14"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="4×4"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_17"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4×4 Standard"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="Endless • Reach 2,048 &amp; beyond"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_best_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/best"
                        android:textColor="#1E2024"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 2: 5x5 Extended -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mode_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_14"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/dp_18"
                app:cardElevation="@dimen/dp_2"
                app:strokeColor="#D9D7CE"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_52"
                        android:layout_height="@dimen/dp_52"
                        app:cardBackgroundColor="#ECEBE5"
                        app:cardCornerRadius="@dimen/dp_14"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="5×5"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_17"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5×5 Extended"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="Endless • Reach 8,192 &amp; beyond"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_best_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/best"
                        android:textColor="#1E2024"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 3: 6x6 Expanded -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mode_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_20"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/dp_18"
                app:cardElevation="@dimen/dp_2"
                app:strokeColor="#D9D7CE"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_52"
                        android:layout_height="@dimen/dp_52"
                        app:cardBackgroundColor="#ECEBE5"
                        app:cardCornerRadius="@dimen/dp_14"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="6×6"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_17"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6×6 Expanded"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="Endless • Reach 16,384 &amp; beyond"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_best_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/best"
                        android:textColor="#1E2024"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Navigation Bar: Records, Palette, Guide -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_dashboard_stats"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_42"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:layout_weight="1"
                    android:text="@string/nav_records"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_12"
                    app:cornerRadius="@dimen/dp_12"
                    app:strokeColor="#D9D7CE" />

                <Button
                    android:id="@+id/btn_dashboard_themes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_42"
                    android:layout_marginStart="@dimen/dp_3"
                    android:layout_marginEnd="@dimen/dp_3"
                    android:layout_weight="1"
                    android:text="@string/nav_palette"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_12"
                    app:cornerRadius="@dimen/dp_12"
                    app:strokeColor="#D9D7CE" />

                <Button
                    android:id="@+id/btn_dashboard_help"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_42"
                    android:layout_marginStart="@dimen/dp_5"
                    android:layout_weight="1"
                    android:text="@string/nav_guide"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_12"
                    app:cornerRadius="@dimen/dp_12"
                    app:strokeColor="#D9D7CE" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
