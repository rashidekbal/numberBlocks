<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Board Illustration Card matching first time instruction.jpeg -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_220"
        android:layout_height="@dimen/dp_220"
        app:cardBackgroundColor="#BBADA0"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="@dimen/dp_2"
        app:cardUseCompatPadding="true"
        app:strokeWidth="0dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="4"
            android:rowCount="4"
            android:padding="@dimen/dp_6">

            <!-- Row 0 -->
            <TextView style="@style/MiniTileStyle" android:background="#EEE4DA" android:text="2" android:textColor="#776E65" />
            <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
            <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
            <View style="@style/MiniTileStyle" android:background="#CDC1B4" />

            <!-- Row 1 -->
            <TextView style="@style/MiniTileStyle" android:background="#F2B179" android:text="8" android:textColor="#FFFFFF" />
            <TextView style="@style/MiniTileStyle" android:background="#EDE0C8" android:text="4" android:textColor="#776E65" />
            <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
            <TextView style="@style/MiniTileStyle" android:background="#EEE4DA" android:text="2" android:textColor="#776E65" />

            <!-- Row 2 -->
            <TextView style="@style/MiniTileStyle" android:background="#EEE4DA" android:text="2" android:textColor="#776E65" />
            <TextView style="@style/MiniTileStyle" android:background="#F2B179" android:text="8" android:textColor="#FFFFFF" />
            <TextView style="@style/MiniTileStyle" android:background="#EDC22E" android:text="2048" android:textColor="#FFFFFF" android:textSize="@dimen/sp_11" />
            <TextView style="@style/MiniTileStyle" android:background="#F2B179" android:text="8" android:textColor="#FFFFFF" />

            <!-- Row 3 -->
            <TextView style="@style/MiniTileStyle" android:background="#EDCF72" android:text="128" android:textColor="#FFFFFF" android:textSize="@dimen/sp_12" />
            <TextView style="@style/MiniTileStyle" android:background="#EDC850" android:text="512" android:textColor="#FFFFFF" android:textSize="@dimen/sp_12" />
            <TextView style="@style/MiniTileStyle" android:background="#F65E3B" android:text="64" android:textColor="#FFFFFF" />
            <TextView style="@style/MiniTileStyle" android:background="#F67C5F" android:text="32" android:textColor="#FFFFFF" />
        </GridLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Instruction Text matching first time instruction.jpeg -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:gravity="center"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:text="@string/tutorial_goal_desc"
        android:textColor="#1A1A1A"
        android:textSize="@dimen/sp_15"
        android:textStyle="bold" />

</LinearLayout>
