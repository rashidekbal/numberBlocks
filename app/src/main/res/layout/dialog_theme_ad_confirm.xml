<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="@dimen/dp_24">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_3"
        app:cardUseCompatPadding="true"
        app:strokeColor="#D9D7CE"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/dp_24">

            <TextView
                android:id="@+id/tv_theme_confirm_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_change_title"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_theme_confirm_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:gravity="center"
                android:text="Watch a short video ad to switch to this theme?"
                android:textColor="#737680"
                android:textSize="@dimen/sp_13" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_theme_confirm_watch"
                    style="@style/GameButton.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_54"
                    android:backgroundTint="#F59E0B"
                    android:text="WATCH AD 🎬"
                    android:textColor="#181A1F"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_16" />

                <Button
                    android:id="@+id/btn_theme_confirm_cancel"
                    style="@style/GameButton.Text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginTop="@dimen/dp_6"
                    android:text="Cancel"
                    android:textColor="#737680"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
