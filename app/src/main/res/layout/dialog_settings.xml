<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_3"
        app:cardUseCompatPadding="true"
        app:strokeColor="#D9D7CE"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold" />

            <!-- Player Profile Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_settings_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_8"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FAF9F6"
                app:cardCornerRadius="@dimen/dp_14"
                app:cardElevation="0dp"
                app:strokeColor="#E3E1D8"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_10">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/dp_44"
                        android:layout_height="@dimen/dp_44"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="@dimen/dp_22"
                        app:cardElevation="0dp"
                        app:strokeColor="#F59E0B"
                        app:strokeWidth="@dimen/dp_1">

                        <ImageView
                            android:id="@+id/iv_settings_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_avatar_hero" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_settings_player_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Player"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_15"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_settings_profile_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to change avatar &amp; nickname"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_11" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/dp_18"
                        android:layout_height="@dimen/dp_18"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="#737680" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Setting 1: Sound -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_speaker"
                    android:contentDescription="@string/cd_sound_icon"
                    app:tint="#6E6E6E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_14"
                    android:layout_weight="1"
                    android:text="@string/sound"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_sound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#00C853"
                    app:trackTint="#A5D6A7" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_14"
                android:background="#ECEBE5" />

            <!-- Setting 2: Background Tone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_music"
                    android:contentDescription="@string/cd_music_icon"
                    app:tint="#6E6E6E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_14"
                    android:layout_weight="1"
                    android:text="@string/music"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_music"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#00C853"
                    app:trackTint="#A5D6A7" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_14"
                android:background="#ECEBE5" />

            <!-- Setting 3: Haptics -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_vibrate"
                    android:contentDescription="@string/cd_vibrate_icon"
                    app:tint="#6E6E6E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_14"
                    android:layout_weight="1"
                    android:text="@string/vibration"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_haptics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#00C853"
                    app:trackTint="#A5D6A7" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_14"
                android:background="#ECEBE5" />

            <!-- Setting 3: Theme -->
            <Button
                android:id="@+id/btn_settings_change_theme"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:text="@string/select_theme"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:icon="@drawable/ic_sun"
                app:iconTint="#1E2024"
                app:iconGravity="textStart"
                app:cornerRadius="@dimen/dp_16"
                app:strokeColor="#D9D7CE" />

            <!-- Setting 4: Game Information & Legal -->
            <Button
                android:id="@+id/btn_settings_info"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_52"
                android:layout_marginTop="@dimen/dp_8"
                android:text="@string/info_title"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:icon="@drawable/ic_info"
                app:iconTint="#1E2024"
                app:iconGravity="textStart"
                app:cornerRadius="@dimen/dp_16"
                app:strokeColor="#D9D7CE" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:strokeColor="#D9D7CE"
                app:strokeWidth="1dp"
                app:cardCornerRadius="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_8"
                >
                <Button
                    android:id="@+id/btn_close_settings"
                    style="@style/GameButton.Text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"

                    android:text="@string/done"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
