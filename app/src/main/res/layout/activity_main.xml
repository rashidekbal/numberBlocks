<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF9F6"
    android:paddingStart="@dimen/dp_18"
    android:paddingEnd="@dimen/dp_18"
    android:paddingTop="@dimen/dp_10"
    android:paddingBottom="@dimen/dp_8">

    <!-- Top Bar: Navigation & Controls -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Pause Menu Button (Circular) -->
        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_circle_surface"
            android:contentDescription="@string/cd_pause_menu"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_pause"
            app:tint="#1E2024" />

        <!-- Title & Mode Center Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/title_2048"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_24"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_mode_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="4×4 STANDARD"
                android:textColor="#737680"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Theme Toggle Button (Circular Sun) -->
        <ImageButton
            android:id="@+id/btn_theme_toggle"
            android:layout_width="@dimen/dp_44"
            android:layout_height="@dimen/dp_44"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_circle_surface"
            android:contentDescription="@string/cd_theme_toggle"
            android:padding="@dimen/dp_11"
            android:src="@drawable/ic_sun"
            app:tint="#1E2024" />
    </RelativeLayout>

    <!-- Precision HUD Cards: Score & Record -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/dp_12">

        <!-- Score Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_6"
            app:cardBackgroundColor="#F0EFEA"
            app:cardCornerRadius="@dimen/dp_16"
            app:cardElevation="0dp"
            app:strokeColor="#E3E1D8"
            app:strokeWidth="@dimen/dp_1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/dp_10">

                <TextView
                    android:id="@+id/tv_score_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/score"
                    android:textColor="#737680"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#161719"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Record Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_best"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_6"
            app:cardBackgroundColor="#F0EFEA"
            app:cardCornerRadius="@dimen/dp_16"
            app:cardElevation="0dp"
            app:strokeColor="#E3E1D8"
            app:strokeWidth="@dimen/dp_1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/dp_10">

                <TextView
                    android:id="@+id/tv_best_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/best"
                    android:textColor="#737680"
                    android:textSize="@dimen/sp_10"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_best"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#161719"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Sub-bar: Consecutive Merges & Revert -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/dp_10">

        <TextView
            android:id="@+id/tv_combo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Join the numbers and get to the 2048 tile!"
            android:textColor="#737680"
            android:textSize="@dimen/sp_12" />

        <Button
            android:id="@+id/btn_undo"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_36"
            android:text="@string/undo"
            android:textColor="#1E2024"
            android:textSize="@dimen/sp_11"
            android:paddingStart="@dimen/dp_12"
            android:paddingEnd="@dimen/dp_12"
            app:strokeColor="#D9D7CE"
            app:cornerRadius="@dimen/dp_10" />
    </LinearLayout>

    <!-- Game Board Well -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginBottom="@dimen/dp_8">

        <com.redcodersgroup.numberblocks.ui.BoardView
            android:id="@+id/board_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- Floating Milestone Celebration Popup (No modal dialog window, no OK button) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_milestone_celebration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:cardBackgroundColor="#1E2024"
            app:cardCornerRadius="@dimen/dp_26"
            app:cardElevation="@dimen/dp_12"
            app:cardUseCompatPadding="true"
            app:strokeColor="#FFD54F"
            app:strokeWidth="@dimen/dp_2">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/dp_18"
                android:paddingEnd="@dimen/dp_20"
                android:paddingTop="@dimen/dp_10"
                android:paddingBottom="@dimen/dp_10">

                <TextView
                    android:id="@+id/tv_celebration_tile"
                    android:layout_width="@dimen/dp_44"
                    android:layout_height="@dimen/dp_44"
                    android:background="@drawable/circle_badge"
                    android:backgroundTint="#EDC22E"
                    android:gravity="center"
                    android:text="@string/title_2048"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_14"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="✦ MILESTONE REACHED ✦"
                        android:textColor="#FFD54F"
                        android:textSize="@dimen/sp_10"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_celebration_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tile 2048 Unlocked!"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Ad Container -->
    <FrameLayout
        android:id="@+id/banner_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_gravity="bottom|center_horizontal" />
</LinearLayout>
