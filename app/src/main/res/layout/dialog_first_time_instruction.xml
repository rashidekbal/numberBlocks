<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FAF8F5"
        app:cardCornerRadius="@dimen/dp_28"
        app:cardElevation="@dimen/dp_6"
        app:cardUseCompatPadding="true"
        app:strokeColor="#E6E3DB"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/dp_24">

            <!-- Header: Close 'x' & Centered Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btn_tutorial_close"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_close"
                    android:src="@drawable/ic_close"
                    app:tint="#6E6E6E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="How to play"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 3-Slide ViewPager2 -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp_tutorial"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_290"
                android:layout_marginTop="@dimen/dp_16" />

            <!-- Indicator Dots (Clickable) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot_1"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"
                    android:background="@drawable/circle_badge"
                    android:backgroundTint="#00C853" />

                <View
                    android:id="@+id/dot_2"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:background="@drawable/circle_badge"
                    android:backgroundTint="#D6D6D6" />

                <View
                    android:id="@+id/dot_3"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"
                    android:background="@drawable/circle_badge"
                    android:backgroundTint="#D6D6D6" />
            </LinearLayout>

            <!-- Action Button: Next / Let's play! -->
            <Button
                android:id="@+id/btn_tutorial_action"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:layout_marginTop="@dimen/dp_18"
                android:backgroundTint="#10B981"
                android:text="@string/next"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                app:cornerRadius="@dimen/dp_28" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
