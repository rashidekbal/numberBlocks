<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_22"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_8">

    <!-- Top Bar: Title & Settings Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_home_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_grid_size"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_home_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="@string/select_board_dimension"
                android:textColor="#737680"
                android:textSize="@dimen/sp_11" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_home_settings"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_circle_surface"
            android:contentDescription="@string/cd_settings"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_settings"
            app:tint="#1E2024" />
    </RelativeLayout>

    <!-- Grid Selection Hero Case Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Top Grid Size Selector Tabs -->
            <LinearLayout
                android:id="@+id/layout_grid_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginBottom="@dimen/dp_16"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 4x4 Tab -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tab_hero_4"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_44"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/dp_14"
                    app:cardElevation="0dp"
                    app:strokeWidth="@dimen/dp_1">

                    <TextView
                        android:id="@+id/tv_tab_hero_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="4×4"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 5x5 Tab -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tab_hero_5"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_44"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_3"
                    android:layout_marginEnd="@dimen/dp_3"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/dp_14"
                    app:cardElevation="0dp"
                    app:strokeWidth="@dimen/dp_1">

                    <TextView
                        android:id="@+id/tv_tab_hero_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="5×5"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 6x6 Tab -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tab_hero_6"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_44"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/dp_6"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/dp_14"
                    app:cardElevation="0dp"
                    app:strokeWidth="@dimen/dp_1">

                    <TextView
                        android:id="@+id/tv_tab_hero_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="6×6"
                        android:textSize="@dimen/sp_15"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Hero Board Showcase Card (Tap to play) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero_board"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:layout_marginBottom="@dimen/dp_16"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="@dimen/dp_28"
                app:cardElevation="@dimen/dp_4"
                app:cardUseCompatPadding="true"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/dp_20"
                    android:paddingTop="@dimen/dp_24"
                    android:paddingEnd="@dimen/dp_20"
                    android:paddingBottom="@dimen/dp_20">

                    <!-- Visual Board Preview -->
                    <com.redcodersgroup.numberblocks.ui.BoardPreviewView
                        android:id="@+id/preview_hero_board"
                        android:layout_width="@dimen/dp_220"
                        android:layout_height="@dimen/dp_220"
                        android:layout_gravity="center" />

                    <!-- Grid Size Label Directly Below Board -->
                    <TextView
                        android:id="@+id/tv_hero_grid_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:text="4 × 4"
                        android:textSize="@dimen/sp_26"
                        android:textStyle="bold" />

                    <!-- Indicator Dots -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_12"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dot_hero_4"
                            android:layout_width="@dimen/dp_20"
                            android:layout_height="@dimen/dp_6"
                            android:layout_marginEnd="@dimen/dp_4" />

                        <View
                            android:id="@+id/dot_hero_5"
                            android:layout_width="@dimen/dp_6"
                            android:layout_height="@dimen/dp_6"
                            android:layout_marginStart="@dimen/dp_2"
                            android:layout_marginEnd="@dimen/dp_2" />

                        <View
                            android:id="@+id/dot_hero_6"
                            android:layout_width="@dimen/dp_6"
                            android:layout_height="@dimen/dp_6"
                            android:layout_marginStart="@dimen/dp_4" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Navigation Bar: Records, Palette, Guide -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_home_stats"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:layout_weight="1"
                    android:text="@string/nav_records"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_14"
                    app:strokeColor="#D9D7CE" />

                <Button
                    android:id="@+id/btn_home_themes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginStart="@dimen/dp_3"
                    android:layout_marginEnd="@dimen/dp_3"
                    android:layout_weight="1"
                    android:text="@string/nav_palette"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_14"
                    app:strokeColor="#D9D7CE" />

                <Button
                    android:id="@+id/btn_home_help"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginStart="@dimen/dp_5"
                    android:layout_weight="1"
                    android:text="@string/nav_guide"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_14"
                    app:strokeColor="#D9D7CE" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Banner Container -->
    <FrameLayout
        android:id="@+id/home_banner_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_gravity="bottom|center_horizontal" />

</LinearLayout>
