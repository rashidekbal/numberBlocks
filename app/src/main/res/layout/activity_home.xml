<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF9F6"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/dp_22"
    android:paddingEnd="@dimen/dp_22"
    android:paddingTop="@dimen/dp_12"
    android:paddingBottom="@dimen/dp_8">

    <!-- Top Bar: Title & Settings Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_home_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/choose_grid_size"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_home_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_2"
                android:text="@string/select_board_dimension"
                android:textColor="#737680"
                android:textSize="@dimen/sp_11" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_home_settings"
            android:layout_width="@dimen/dp_48"
            android:layout_height="@dimen/dp_48"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_circle_surface"
            android:contentDescription="@string/cd_settings"
            android:padding="@dimen/dp_12"
            android:src="@drawable/ic_settings"
            app:tint="#1E2024" />
    </RelativeLayout>

    <!-- Scrollable Grid Selection Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Resume Active Game Hero Card (Conditional) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_home_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/dp_20"
                app:cardElevation="@dimen/dp_4"
                app:cardUseCompatPadding="true"
                app:strokeColor="#E3DDD3"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_home_resume_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#FEF3C7"
                            android:paddingStart="@dimen/dp_10"
                            android:paddingEnd="@dimen/dp_10"
                            android:paddingTop="@dimen/dp_4"
                            android:paddingBottom="@dimen/dp_4"
                            android:text="ACTIVE RUN • 4×4"
                            android:textColor="#B45309"
                            android:textSize="@dimen/sp_10"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_home_resume_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_6"
                            android:text="@string/score"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_home_resume_run"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_50"
                        android:backgroundTint="#1E2024"
                        android:paddingStart="@dimen/dp_20"
                        android:paddingEnd="@dimen/dp_20"
                        android:text="@string/resume"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/sp_13"
                        android:textStyle="bold"
                        app:cornerRadius="@dimen/dp_16" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 1: 4x4 Standard -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mode_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_14"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/dp_20"
                app:cardElevation="@dimen/dp_3"
                app:cardUseCompatPadding="true"
                app:strokeColor="#E4DFD7"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_mode_4_badge"
                        android:layout_width="@dimen/dp_54"
                        android:layout_height="@dimen/dp_54"
                        app:cardBackgroundColor="@color/game_mode_4_bg"
                        app:cardCornerRadius="@dimen/dp_16"
                        app:cardElevation="0dp"
                        app:strokeColor="#E3D8C8"
                        app:strokeWidth="@dimen/dp_1">

                        <TextView
                            android:id="@+id/tv_mode_4_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="4×4"
                            android:textColor="@color/game_mode_4_accent"
                            android:textSize="@dimen/sp_17"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_mode_4_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_4x4_standard"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_mode_4_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="@string/mode_4x4_desc"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_best_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FAF6EB"
                        android:paddingStart="@dimen/dp_8"
                        android:paddingEnd="@dimen/dp_8"
                        android:paddingTop="@dimen/dp_4"
                        android:paddingBottom="@dimen/dp_4"
                        android:text="@string/best"
                        android:textColor="#92400E"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 2: 5x5 Expanded -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mode_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_14"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/dp_20"
                app:cardElevation="@dimen/dp_3"
                app:cardUseCompatPadding="true"
                app:strokeColor="#E4DFD7"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_mode_5_badge"
                        android:layout_width="@dimen/dp_54"
                        android:layout_height="@dimen/dp_54"
                        app:cardBackgroundColor="@color/game_mode_5_bg"
                        app:cardCornerRadius="@dimen/dp_16"
                        app:cardElevation="0dp"
                        app:strokeColor="#D1DFEE"
                        app:strokeWidth="@dimen/dp_1">

                        <TextView
                            android:id="@+id/tv_mode_5_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="5×5"
                            android:textColor="@color/game_mode_5_accent"
                            android:textSize="@dimen/sp_17"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_mode_5_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_5x5_extended"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_mode_5_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="@string/mode_5x5_desc"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_best_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FAF6EB"
                        android:paddingStart="@dimen/dp_8"
                        android:paddingEnd="@dimen/dp_8"
                        android:paddingTop="@dimen/dp_4"
                        android:paddingBottom="@dimen/dp_4"
                        android:text="@string/best"
                        android:textColor="#92400E"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 3: 6x6 Master -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mode_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_20"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/dp_20"
                app:cardElevation="@dimen/dp_3"
                app:cardUseCompatPadding="true"
                app:strokeColor="#E4DFD7"
                app:strokeWidth="@dimen/dp_1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_16">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_mode_6_badge"
                        android:layout_width="@dimen/dp_54"
                        android:layout_height="@dimen/dp_54"
                        app:cardBackgroundColor="@color/game_mode_6_bg"
                        app:cardCornerRadius="@dimen/dp_16"
                        app:cardElevation="0dp"
                        app:strokeColor="#DFD3EB"
                        app:strokeWidth="@dimen/dp_1">

                        <TextView
                            android:id="@+id/tv_mode_6_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="6×6"
                            android:textColor="@color/game_mode_6_accent"
                            android:textSize="@dimen/sp_17"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_mode_6_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mode_6x6_expanded"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_mode_6_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_2"
                            android:text="@string/mode_6x6_desc"
                            android:textColor="#737680"
                            android:textSize="@dimen/sp_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_best_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FAF6EB"
                        android:paddingStart="@dimen/dp_8"
                        android:paddingEnd="@dimen/dp_8"
                        android:paddingTop="@dimen/dp_4"
                        android:paddingBottom="@dimen/dp_4"
                        android:text="@string/best"
                        android:textColor="#92400E"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Navigation Bar: Records, Palette, Guide -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_home_stats"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginEnd="@dimen/dp_5"
                    android:layout_weight="1"
                    android:text="@string/nav_records"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_14"
                    app:strokeColor="#D9D7CE" />

                <Button
                    android:id="@+id/btn_home_themes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginStart="@dimen/dp_3"
                    android:layout_marginEnd="@dimen/dp_3"
                    android:layout_weight="1"
                    android:text="@string/nav_palette"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_14"
                    app:strokeColor="#D9D7CE" />

                <Button
                    android:id="@+id/btn_home_help"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_50"
                    android:layout_marginStart="@dimen/dp_5"
                    android:layout_weight="1"
                    android:text="@string/nav_guide"
                    android:textColor="#1E2024"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_14"
                    app:strokeColor="#D9D7CE" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Banner Container -->
    <FrameLayout
        android:id="@+id/home_banner_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_gravity="bottom|center_horizontal" />

</LinearLayout>
