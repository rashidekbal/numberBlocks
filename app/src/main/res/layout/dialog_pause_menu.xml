<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FAF8F5"
        app:cardCornerRadius="@dimen/dp_28"
        app:cardElevation="@dimen/dp_6"
        app:strokeColor="#E6E3DB"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_24">

            <!-- Header: Close 'x' & Centered Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btn_pause_close"
                    android:contentDescription="@string/cd_close"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="#6E6E6E" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/paused"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Option 1: Sound -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_speaker"
                    android:contentDescription="@string/cd_sound_icon"
                    app:tint="#6E6E6E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_14"
                    android:layout_weight="1"
                    android:text="@string/sound"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pause_sound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#00C853"
                    app:trackTint="#A5D6A7" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_14"
                android:background="#EAE7DF" />

            <!-- Option 2: Vibration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_vibrate"
                    android:contentDescription="@string/cd_vibrate_icon"
                    app:tint="#6E6E6E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_14"
                    android:layout_weight="1"
                    android:text="@string/vibration"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pause_vibration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:thumbTint="#00C853"
                    app:trackTint="#A5D6A7" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_14"
                android:background="#EAE7DF" />

            <!-- Option 3: How to play -->
            <LinearLayout
                android:id="@+id/row_pause_how_to_play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_4">

                <ImageView
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:src="@drawable/ic_lightbulb"
                    android:contentDescription="@string/cd_help_icon"
                    app:tint="#6E6E6E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_14"
                    android:layout_weight="1"
                    android:text="@string/how_to_play"
                    android:textColor="#1A1A1A"
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:src="@drawable/ic_chevron_right"
                    android:contentDescription="@string/cd_chevron"
                    app:tint="#6E6E6E" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_22"
                android:background="#EAE7DF" />

            <!-- Primary Action: Continue (Green Pill) -->
            <Button
                android:id="@+id/btn_pause_continue"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_50"
                android:backgroundTint="#00C853"
                android:text="@string/continue_label"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_15"
                android:textStyle="bold"
                app:cornerRadius="@dimen/dp_25" />

            <!-- Secondary Actions: Restart & Home (Gray Pills) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_pause_restart"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginEnd="@dimen/dp_6"
                    android:layout_weight="1"
                    android:backgroundTint="#666666"
                    android:text="Restart"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_24" />

                <Button
                    android:id="@+id/btn_pause_home"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_48"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_weight="1"
                    android:backgroundTint="#666666"
                    android:text="Home"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/dp_24" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
