<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8EF"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center">

    <!-- Center Content -->
    <LinearLayout
        android:id="@+id/center_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical">

        <!-- 2x2 Mini Game Board Showcase -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/splash_board_well"
            android:layout_width="168dp"
            android:layout_height="168dp"
            app:cardBackgroundColor="#BBADA0"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true"
            app:strokeColor="#15000000"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Row 1: Tiles 2 and 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- Tile 2 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/splash_tile_2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        app:cardBackgroundColor="#EEE4DA"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="2"
                            android:textColor="#776E65"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tile 4 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/splash_tile_4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="4dp"
                        app:cardBackgroundColor="#EDE0C8"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="4"
                            android:textColor="#776E65"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2: Tiles 8 and 2048 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <!-- Tile 8 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/splash_tile_8"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="#F2B179"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="8"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Tile 2048 (Radiant Milestone) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/splash_tile_2048"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="4dp"
                        app:cardBackgroundColor="#F59E0B"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="5dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="2048"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Game Title -->
        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.04"
            android:text="NUMBER BLOCKS"
            android:textColor="#776E65"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Tagline Capsule Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/splash_tagline_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#EDE0C8"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#CDC1B4"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/splash_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:text="SLIDE • MERGE • 2048"
                android:textColor="#8F7A66"
                android:textSize="11sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Arcade Progress Bar Track -->
        <FrameLayout
            android:id="@+id/splash_progress_track"
            android:layout_width="140dp"
            android:layout_height="6dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/pill_badge"
            android:backgroundTint="#EDE0C8">

            <View
                android:id="@+id/splash_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/pill_badge"
                android:backgroundTint="#F59E0B" />
        </FrameLayout>
    </LinearLayout>

    <!-- Version / Studio Footer -->
    <TextView
        android:id="@+id/splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:letterSpacing="0.12"
        android:text="ARCHITECTURAL CASUAL PUZZLE"
        android:textColor="#8F7A66"
        android:textSize="11sp"
        android:textStyle="bold" />

</RelativeLayout>