<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Board Illustration Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="@dimen/dp_220"
        android:layout_height="@dimen/dp_220"
        app:cardBackgroundColor="#BBADA0"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="@dimen/dp_2"
        app:strokeWidth="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 4x4 Base Grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="4"
                android:rowCount="4"
                android:padding="@dimen/dp_6">

                <!-- Row 0 -->
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />

                <!-- Row 1 -->
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <TextView style="@style/MiniTileStyle" android:background="#EEE4DA" android:text="2" android:textColor="#776E65" />
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <TextView style="@style/MiniTileStyle" android:background="#F59563" android:text="16" android:textColor="#FFFFFF" />

                <!-- Row 2 -->
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <TextView style="@style/MiniTileStyle" android:background="#EEE4DA" android:text="2" android:textColor="#776E65" />
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <TextView style="@style/MiniTileStyle" android:background="#F59563" android:text="16" android:textColor="#FFFFFF" />

                <!-- Row 3 -->
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <TextView style="@style/MiniTileStyle" android:background="#EDE0C8" android:text="4" android:textColor="#776E65" />
                <View style="@style/MiniTileStyle" android:background="#CDC1B4" />
                <TextView style="@style/MiniTileStyle" android:background="#F67C5F" android:text="32" android:textColor="#FFFFFF" />
            </GridLayout>

            <!-- Guide Overlays: Math operators & Downward arrows -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Col 1: Vertical Arrow pointing down -->
                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_140"
                    android:layout_marginStart="@dimen/dp_76"
                    android:layout_marginTop="@dimen/dp_56"
                    android:src="@drawable/ic_arrow_down_guide"
                    android:contentDescription="@string/cd_tutorial_arrow" />

                <!-- Col 1: '+' operator -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_79"
                    android:layout_marginTop="@dimen/dp_100"
                    android:text="+"
                    android:textColor="#F5A623"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold" />

                <!-- Col 1: '=' operator -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_80"
                    android:layout_marginTop="@dimen/dp_150"
                    android:text="="
                    android:textColor="#F5A623"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold" />

                <!-- Col 3: Vertical Arrow pointing down -->
                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_140"
                    android:layout_marginStart="@dimen/dp_178"
                    android:layout_marginTop="@dimen/dp_56"
                    android:src="@drawable/ic_arrow_down_guide"
                    android:contentDescription="@string/cd_tutorial_arrow" />

                <!-- Col 3: '+' operator -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_181"
                    android:layout_marginTop="@dimen/dp_100"
                    android:text="+"
                    android:textColor="#F5A623"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold" />

                <!-- Col 3: '=' operator -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_182"
                    android:layout_marginTop="@dimen/dp_150"
                    android:text="="
                    android:textColor="#F5A623"
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold" />
            </RelativeLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Instruction Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:gravity="center"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:text="@string/tutorial_top_down_desc"
        android:textColor="#1A1A1A"
        android:textSize="@dimen/sp_15"
        android:textStyle="bold" />

</LinearLayout>
