<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="@dimen/dp_20">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_3"
        app:strokeColor="#D9D7CE"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/dp_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistics"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold" />

            <!-- Stats Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:orientation="vertical">

                <!-- Row 1: Games & Peak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/dp_6"
                        app:cardBackgroundColor="#FAF9F6"
                        app:cardCornerRadius="@dimen/dp_12"
                        app:strokeColor="#E3E1D8"
                        app:strokeWidth="@dimen/dp_1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/dp_10">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GAMES"
                                android:textColor="#737680"
                                android:textSize="@dimen/sp_10"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_stats_games_played"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:text="24"
                                android:textColor="#1E2024"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_6"
                        app:cardBackgroundColor="#FAF9F6"
                        app:cardCornerRadius="@dimen/dp_12"
                        app:strokeColor="#E3E1D8"
                        app:strokeWidth="@dimen/dp_1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="@dimen/dp_10">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BEST TILE"
                                android:textColor="#737680"
                                android:textSize="@dimen/sp_10"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_stats_highest_tile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:text="2048"
                                android:textColor="#1E2024"
                                android:textSize="@dimen/sp_16"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Row 2: 4x4 Best -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    app:cardBackgroundColor="#FAF9F6"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:strokeColor="#E3E1D8"
                    app:strokeWidth="@dimen/dp_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dp_12">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="4×4 Best Score"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_13" />

                        <TextView
                            android:id="@+id/tv_stats_best_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18,460"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 3: 5x5 Best -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    app:cardBackgroundColor="#FAF9F6"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:strokeColor="#E3E1D8"
                    app:strokeWidth="@dimen/dp_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dp_12">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="5×5 Best Score"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_13" />

                        <TextView
                            android:id="@+id/tv_stats_best_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="32,880"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Row 4: 6x6 Best -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    app:cardBackgroundColor="#FAF9F6"
                    app:cardCornerRadius="@dimen/dp_12"
                    app:strokeColor="#E3E1D8"
                    app:strokeWidth="@dimen/dp_1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/dp_12">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="6×6 Best Score"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_13" />

                        <TextView
                            android:id="@+id/tv_stats_best_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="64,120"
                            android:textColor="#1E2024"
                            android:textSize="@dimen/sp_14"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <Button
                android:id="@+id/btn_close_stats"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_8"
                android:text="Close"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
