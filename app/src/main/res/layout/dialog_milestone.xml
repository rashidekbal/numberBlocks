<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="@dimen/dp_24">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/dp_20"
        app:cardElevation="@dimen/dp_3"
        app:strokeColor="#D9D7CE"
        app:strokeWidth="@dimen/dp_1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/dp_24">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Milestone"
                android:textColor="#1E2024"
                android:textSize="@dimen/sp_18"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_72"
                android:layout_height="@dimen/dp_72"
                android:layout_marginTop="@dimen/dp_14"
                app:cardBackgroundColor="#2C2B28"
                app:cardCornerRadius="@dimen/dp_16"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tv_milestone_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="2048"
                    android:textColor="#FAF9F6"
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="Threshold reached."
                android:textColor="#737680"
                android:textSize="@dimen/sp_13" />

            <Button
                android:id="@+id/btn_milestone_continue"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_44"
                android:layout_marginTop="@dimen/dp_18"
                android:backgroundTint="#1E2024"
                android:text="Continue"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                app:cornerRadius="@dimen/dp_10" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
