<resources>
    <style name="Theme.NumberBlocks" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="fontFamily">@font/game_font</item>
        <item name="android:fontFamily">@font/game_font</item>
    </style>

    <style name="MiniTileStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">@dimen/dp_3</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/sp_13</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/game_font</item>
        <item name="android:fontFamily">@font/game_font</item>
    </style>

    <style name="GameButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">@dimen/dp_54</item>
        <item name="android:textSize">@dimen/sp_15</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/dp_16</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="fontFamily">@font/game_font</item>
        <item name="android:fontFamily">@font/game_font</item>
    </style>

    <style name="GameButton.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/dp_52</item>
        <item name="android:textSize">@dimen/sp_14</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">@dimen/dp_16</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/border_subtle</item>
        <item name="strokeWidth">@dimen/dp_1</item>
        <item name="fontFamily">@font/game_font</item>
        <item name="android:fontFamily">@font/game_font</item>
    </style>

    <style name="GameButton.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_height">@dimen/dp_48</item>
        <item name="android:textSize">@dimen/sp_14</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="fontFamily">@font/game_font</item>
        <item name="android:fontFamily">@font/game_font</item>
    </style>
</resources>
