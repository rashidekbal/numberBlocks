<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow / Shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#30F59E0B" />
        </shape>
    </item>
    <!-- Vibrant Golden Active Ring -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#FDE047" />
            <solid android:color="#20FDE047" />
        </shape>
    </item>
</layer-list>
